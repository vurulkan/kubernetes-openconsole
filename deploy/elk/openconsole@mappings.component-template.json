              "type": "boolean"
            },
            "previous": {
              "type": "boolean"
            },
            "yaml_from": {
              "type": "keyword"
            },
            "yaml_to": {
              "type": "keyword"
            },
            "owner": {
              "type": "keyword"
            },
            "started_at": {
              "type": "date"
            },
            "size_bytes": {
              "type": "long"
            },
            "truncate_reason": {
              "type": "keyword"
            },
            "retention_days": {
              "type": "long"
            },
            "login_method": {
              "type": "keyword"
            },
            "account_source": {
              "type": "keyword"
            },
            "linked_by": {
              "type": "keyword"
            },
            "signed_in_as": {
              "type": "keyword"
            },
            "must_change": {
              "type": "boolean"
            },
            "auto_provisioned": {
              "type": "boolean"
            },
            "is_admin": {
              "type": "boolean"
            },
            "is_active": {
              "type": "boolean"
            },
            "groups": {
              "type": "long"
            },
            "count": {
              "type": "long"
            },
            "all": {
              "type": "boolean"
            },
            "id": {
              "type": "long"
            },
            "role": {
              "type": "keyword"
            },
            "grant": {
              "type": "keyword"
            },
            "changed": {
              "type": "keyword"
            },
            "shared": {
              "type": "boolean"
            },
            "summary": {
              "type": "match_only_text"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "managed_by": "kubernetes-openconsole deploy/elk",
    "description": "Fields written by OpenConsole with LOG_FORMAT=ecs. ECS names come from ecs@mappings too; openconsole.* are the resource an action ran against."
  }
