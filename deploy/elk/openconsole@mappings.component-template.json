{
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "match_only_text" },
        "log": {
          "properties": {
            "level": { "type": "keyword" },
            "origin": {
              "properties": {
                "function": { "type": "keyword" },
                "file": { "properties": { "name": { "type": "keyword" }, "line": { "type": "long" } } }
              }
            }
          }
        },
        "event": {
          "properties": {
            "action": { "type": "keyword" },
            "outcome": { "type": "keyword" },
            "kind": { "type": "keyword" },
            "dataset": { "type": "keyword" },
            "duration": { "type": "long" }
          }
        },
        "user": { "properties": { "name": { "type": "keyword" } } },
        "client": { "properties": { "ip": { "type": "ip" } } },
        "user_agent": { "properties": { "original": { "type": "keyword", "ignore_above": 1024 } } },
        "http": {
          "properties": {
            "request": { "properties": { "id": { "type": "keyword" }, "method": { "type": "keyword" } } },
            "response": { "properties": { "status_code": { "type": "long" } } }
          }
        },
        "url": { "properties": { "path": { "type": "keyword" } } },
        "trace": { "properties": { "id": { "type": "keyword" } } },
        "service": {
          "properties": {
            "name": { "type": "keyword" },
            "version": { "type": "keyword" },
            "environment": { "type": "keyword" }
          }
        },
        "ecs": { "properties": { "version": { "type": "keyword" } } },
        "error": { "properties": { "message": { "type": "match_only_text" } } },
        "openconsole": {
          "properties": {
            "cluster": { "type": "keyword" },
            "namespace": { "type": "keyword" },
            "pod": { "type": "keyword" },
            "container": { "type": "keyword" },
            "deployment": { "type": "keyword" },
            "statefulset": { "type": "keyword" },
            "job": { "type": "keyword" },
            "secret": { "type": "keyword" },
            "key": { "type": "keyword" },
            "command": { "type": "keyword" },
            "session_id": { "type": "keyword" },
            "resource": { "type": "keyword" },
            "resource_type": { "type": "keyword" },
            "resource_name": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": { "text": { "type": "match_only_text" } }
            },
            "details": { "type": "match_only_text" },
            "outcome": { "type": "keyword" },
            "reason": { "type": "keyword" },
            "exit_code": { "type": "long" },
            "bytes_in": { "type": "long" },
            "bytes_out": { "type": "long" },
            "ts": { "type": "date" }
          }
        }
      }
    }
  },
  "_meta": {
    "managed_by": "kubernetes-openconsole deploy/elk",
    "description": "Fields written by OpenConsole with LOG_FORMAT=ecs. ECS names come from ecs@mappings too; openconsole.* are the resource an action ran against."
  }
}
