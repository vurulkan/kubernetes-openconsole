                  "type": "match_only_text"
                }
              }
            },
            "details": {
              "type": "match_only_text"
            },
            "outcome": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            },
            "exit_code": {
              "type": "long"
            },
            "bytes_in": {
              "type": "long"
            },
            "bytes_out": {
              "type": "long"
            },
            "ts": {
              "type": "date"
            },
            "verb": {
              "type": "keyword"
            },
            "auth_source": {
              "type": "keyword"
            },
            "cluster_id": {
              "type": "long"
            },
            "restarted_at": {
              "type": "date"
            },
            "replicas_from": {
              "type": "long"
            },
            "replicas_to": {
              "type": "long"
            },
            "pods": {
              "type": "long"
            },
            "phase": {
              "type": "keyword"
            },
            "duration_ms": {
              "type": "long"
            },
            "max_sessions": {
              "type": "long"
            },
