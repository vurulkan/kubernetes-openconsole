{
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "match_only_text"
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            },
            "origin": {
              "properties": {
                "function": {
                  "type": "keyword"
                },
                "file": {
                  "properties": {
                    "name": {
                      "type": "keyword"
                    },
                    "line": {
                      "type": "long"
                    }
                  }
                }
              }
            },
            "logger": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "action": {
              "type": "keyword"
            },
            "outcome": {
              "type": "keyword"
            },
            "kind": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "duration": {
              "type": "long"
            },
            "category": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "client": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "id": {
                  "type": "keyword"
                },
                "method": {
                  "type": "keyword"
                }
              }
            },
            "response": {
              "properties": {
                "status_code": {
                  "type": "long"
                },
                "body": {
                  "properties": {
                    "bytes": {
                      "type": "long"
                    }
                  }
                }
              }
            }
          }
        },
        "url": {
          "properties": {
            "path": {
              "type": "keyword"
            }
          }
        },
        "trace": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            },
            "environment": {
              "type": "keyword"
            }
          }
        },
        "ecs": {
          "properties": {
            "version": {
              "type": "keyword"
            }
          }
        },
        "error": {
          "properties": {
            "message": {
              "type": "match_only_text"
            }
          }
        },
        "openconsole": {
          "properties": {
            "cluster": {
              "type": "keyword"
            },
            "namespace": {
              "type": "keyword"
            },
            "pod": {
              "type": "keyword"
            },
            "container": {
              "type": "keyword"
            },
            "deployment": {
              "type": "keyword"
            },
            "statefulset": {
              "type": "keyword"
            },
            "job": {
              "type": "keyword"
            },
            "secret": {
              "type": "keyword"
            },
            "key": {
              "type": "keyword"
            },
